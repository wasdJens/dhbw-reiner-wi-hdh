    "globals": "17.13.0",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24"
