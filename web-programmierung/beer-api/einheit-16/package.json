    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "12.0.2",
    "@nestjs/websockets": "11.2.7",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.11.1",
    "hbs": "4.4.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
