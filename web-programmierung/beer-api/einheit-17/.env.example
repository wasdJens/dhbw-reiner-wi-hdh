# Vorlage für .env: Datei kopieren und den Wert ersetzen
# Secret, mit dem der Server Tokens signiert und prüft
JWT_SECRET=bitte-ersetzen
# Origin der Webseite, die die API im Browser aufrufen darf (CORS)
CORS_ORIGIN=http://localhost:4200
# Adresse des Brauerei-ERP, das den Lagerbestand liefert
ERP_URL=http://localhost:3100
# API-Key für das ERP, gesendet im Header X-API-Key (Wert aus der .env des ERP)
ERP_API_KEY=erp-demo-key
