              ],
              "path": [
                "v1",
                "personen",
                "P-00068"
              ]
            },
            "description": "Antwortet in Stand 2 mit 410, weil P-00068 gelöscht ist."
          }
        },
        {
          "name": "Stand 1 setzen",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{stammdatenUrl}}/system/stand",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "system",
                "stand"
