{
  "info": {
    "name": "Stammdaten-Server",
    "description": "Beispielanfragen an den Stammdaten-Server der Prismarine Solutions GmbH. Trage in der Variable stammdatenApiKey deinen API-Key ein; alle Anfragen senden ihn im Header X-API-Key. Alle Endpunkte beschreibt die Dokumentation unter {{stammdatenUrl}}/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{stammdatenApiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Personen",
      "description": "Mitarbeiterinnen und Mitarbeiter mit Abteilung, Standort und Status.",
      "item": [
        {
          "name": "Alle Personen in einer Anfrage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stammdatenUrl}}/v1/personen?pro_seite=500",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "v1",
                "personen"
              ],
              "query": [
                {
                  "key": "pro_seite",
                  "value": "500"
                }
              ]
            },
            "description": "Liefert alle 250 Personen von Stand 1 auf einer Seite."
          }
        },
        {
          "name": "Aktive Personen eines Standorts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stammdatenUrl}}/v1/personen?status=aktiv&standort_nr=STO-01&pro_seite=10",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "v1",
                "personen"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "aktiv"
                },
                {
                  "key": "standort_nr",
                  "value": "STO-01"
                },
                {
                  "key": "pro_seite",
                  "value": "10"
                }
              ]
            },
            "description": "Liefert die ersten 10 aktiven Personen am Standort STO-01."
          }
        },
        {
          "name": "Eine Person (P-00017)",
