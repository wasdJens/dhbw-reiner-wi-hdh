    {
      "name": "Datenstände",
      "description": "Wechsel zwischen Stand 1 (Auslieferung) und Stand 2 (nach den Änderungen vom 01.12.2026). Die Anfragen stehen in der Reihenfolge eines Ablaufs.",
      "item": [
        {
          "name": "Datenstand anzeigen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stammdatenUrl}}/system/stand",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "system",
                "stand"
              ]
            },
            "description": "Zeigt, welcher Datenstand gerade gilt."
          }
        },
        {
          "name": "Stand 2 setzen",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{stammdatenUrl}}/system/stand",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "system",
                "stand"
              ]
            },
            "description": "Wechselt auf Stand 2 mit geänderten, neuen, inaktiven und gelöschten Datensätzen.",
            "body": {
              "mode": "raw",
              "raw": "{\"stand\": 2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Geänderte Personen seit Stand 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stammdatenUrl}}/v1/personen?geaendert_seit=2026-11-16T00:00:00Z",
              "host": [
                "{{stammdatenUrl}}"
              ],
              "path": [
                "v1",
                "personen"
              ],
              "query": [
                {
                  "key": "geaendert_seit",
                  "value": "2026-11-16T00:00:00Z"
                }
              ]
            },
            "description": "Liefert die 33 Personen, die in Stand 2 geändert, ausgetreten oder neu sind; gelöschte Personen fehlen in der Liste."
          }
        },
        {
          "name": "Gelöschte Person (P-00068)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stammdatenUrl}}/v1/personen/P-00068",
              "host": [
