# Vorlage für .env: Datei kopieren und bei Bedarf Werte ändern
# Port des Stammdaten-Servers
PORT=3300
# API-Key, den jede Anfrage im Header X-API-Key mitsenden muss
STAMMDATEN_API_KEY=stammdaten-demo-key
# Datenstand beim Start: 1 (Auslieferung) oder 2 (nach Änderungen)
STAMMDATEN_STAND=1
# Verzögert jede Antwort um so viele Millisekunden (0 = keine Verzögerung)
STAMMDATEN_DELAY_MS=0
